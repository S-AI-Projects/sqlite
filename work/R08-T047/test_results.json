  },
  {
    "description": "slice length is way too large",
    "status": "pass",
    "input": "12345",
    "slice_length": 42,
    "expected_result": null,
    "expected_error": "slice length cannot be greater than series length"
  },
  {
    "description": "slice length cannot be zero",
    "status": "pass",
    "input": "12345",
    "slice_length": 0,
    "expected_result": null,
    "expected_error": "slice length cannot be zero"
  },
  {
    "description": "slice length cannot be negative",
    "status": "pass",
    "input": "123",
    "slice_length": -1,
    "expected_result": null,
    "expected_error": "slice length cannot be negative"
  },
  {
    "description": "empty series is invalid",
